NULLSPACE_SECRET_KEY=replace-with-a-long-random-value
MASTER_ADMIN_EMAIL=admin@example.com
MASTER_ADMIN_PASSWORD=replace-with-a-strong-password
NULLSPACE_HOST=127.0.0.1
NULLSPACE_PORT=5000
# Set to 1 when serving over HTTPS so session cookies cannot travel over HTTP.
NULLSPACE_COOKIE_SECURE=0
# Set this to the public origin when deployed behind a trusted reverse proxy.
NULLSPACE_PUBLIC_ORIGIN=http://127.0.0.1:5000
# Optional: enables richer AI-generated question variants from the admin button.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Email OTP delivery.
OTP_DEV_MODE=0
OTP_SMTP_HOST=
OTP_SMTP_PORT=587
OTP_SMTP_TLS=1
OTP_SMTP_USER=
OTP_SMTP_PASSWORD=
OTP_SMTP_FROM=
# Optional Paytm production billing. Leave blank to show teacher contact instead.
PAYTM_MERCHANT_ID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=DEFAULT
PAYTM_API_BASE=https://securegw.paytm.in
NULLSPACE_PUBLIC_ORIGIN=http://127.0.0.1:5000
